  <entry dateCreated="2005-06-23T16:30:31Z" dateModified="2006-09-07T19:24:01Z" guid="44af4d61-fa9c-4b62-8d30-1c70c2e9361b">
    <lexical-unit>
      <form lang="seh">
        <text>khuch</text>
      </form>
    </lexical-unit>
    <trait name="morph-type" value="root"/>
    <citation>
      <form lang="seh">
        <text>khucha</text>
      </form>
    </citation>
    <sense id="cddee31a-556f-4a76-8e75-2be21302d85f">
      <grammatical-info value="Verbo"/>
      <gloss lang="en">
        <text>pull out</text>
      </gloss>
      <gloss lang="pt">
        <text>arrancar</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>
            <span lang="pt">pull out (nail, tooth, etc.)</span>
          </text>
        </form>
        <form lang="pt">
          <text>arrancar (prego, dente etc)</text>
        </form>
      </definition>
      <note>
        <form lang="en">
          <text>cf saka - arancar fruta ou lenha; chodola - fruta; kula - dentes, capim, estaca, coisas no chão, gwisa - causa cair (manga)</text>
        </form>
      </note>
    </sense>
  </entry>
  <entry dateCreated="2005-06-23T16:30:31Z" dateModified="2006-08-28T17:11:00Z" guid="6d5fdb31-6c26-4f20-bab3-8d86a38eea78">
    <lexical-unit>
      <form lang="seh">
        <text>eoo</text>
      </form>
    </lexical-unit>
    <trait name="morph-type" value="stem"/>
    <sense id="d1645b43-54ad-4ae3-86a8-2adc01b10b86">
      <grammatical-info value="Interjeição"/>
      <gloss lang="en">
        <text>oh</text>
      </gloss>
      <gloss lang="pt">
        <text>ai</text>
      </gloss>
      <definition>
        <form lang="pt">
          <text>ai, ó</text>
        </form>
      </definition>
      <note>
        <form lang="en">
          <text>show sadness, disappointment but with submission</text>
        </form>
        <form lang="pt">
          <text>
            <span lang="en">mostra tristeza, disapontamento mas com  submissao</span>
          </text>
        </form>
      </note>
    </sense>
  </entry>
  <entry dateCreated="2005-06-23T15:50:47Z" dateModified="2006-11-10T17:38:12Z" guid="8d3435f5-a7c2-4628-86de-1b02fe3623f6">
    <lexical-unit>
      <form lang="seh">
        <text>-es</text>
      </form>
    </lexical-unit>
    <trait name="morph-type" value="suffix"/>
    <sense id="e2c0d4bd-f0f9-43a8-8f4e-778deabb7a34" order="0">
      <gloss lang="en">
        <text>CAU</text>
      </gloss>
      <gloss lang="pt">
        <text>CAU</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>causative</text>
        </form>
        <form lang="pt">
          <text>causativa</text>
        </form>
      </definition>
      <note>
        <form lang="en">
          <text>it can be ambiguous: kuonisa "cause to see" or "really see"; bva "hear" bvesa "listen" </text>
        </form>
      </note>
      <field type="Parsing Note">
        <form lang="en">
          <text>Question: but adyesa as per #(C)..._ rule but it is picking up the a- subject marker so it fails - add monosyllabic rule - monosyllabic is not working;<span lang="seh">es +/ {monosyllabic} _ |eg adyesa; is / [AIU] [C] ... _ |eg kufambisa kuonisa; es / [OE] [C] ... _ |eg kutemesa; es / [C] ... _ |eg bvesera - this is an attempted work around for monosyllabic, when it gets fixed delete this</span></text>
        </form>
      </field>
    </sense>
  </entry>
