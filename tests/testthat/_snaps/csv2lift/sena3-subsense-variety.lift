  <entry dateCreated="2005-06-23T16:30:32Z" dateModified="2026-09-29T06:16:13Z" id="nyerezera_e0aa351f-d56e-40bb-9dbd-91c3327b7585" guid="e0aa351f-d56e-40bb-9dbd-91c3327b7585">
    <lexical-unit>
      <form lang="seh">
        <text>nyerezer</text>
      </form>
    </lexical-unit>
    <trait name="morph-type" value="root"/>
    <citation>
      <form lang="seh">
        <text>nyerezera</text>
      </form>
    </citation>
    <sense id="2d50f802-27d2-438a-8761-fa5c754d237a">
      <grammatical-info value="Verbo"/>
      <gloss lang="en">
        <text>think</text>
      </gloss>
      <gloss lang="pt">
        <text>pensar</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>think, reflect</text>
        </form>
      </definition>
      <note>
        <form lang="en">
          <text>See: kukumbuka ="recordar" ; manyerezero = "pensamento"</text>
        </form>
      </note>
      <note type="sociolinguistics">
        <form lang="en">
          <text>ACT</text>
        </form>
      </note>
      <example source="Orth; Jac; Meque; Nyazeze">
        <translation type="Free translation"/>
        <note type="reference">
          <form lang="en">
            <text>Orth; Jac; Meque; Nyazeze</text>
          </form>
        </note>
      </example>
      <subsense id="abc99545-0202-43ed-be8f-7264687ca3e9">
        <grammatical-info value="Verbo"/>
        <gloss lang="en">
          <text>remember</text>
        </gloss>
        <gloss lang="pt">
          <text>recordar</text>
        </gloss>
        <example>
          <form lang="seh">
            <text>Usanyerezera pida cita iwe?</text>
          </form>
          <translation type="Free translation">
            <form lang="en">
              <text>Do you remember what you did?</text>
            </form>
            <form lang="pt">
              <text>Recorda aquele que voces fez?</text>
            </form>
          </translation>
        </example>
      </subsense>
    </sense>
  </entry>
