  <entry dateCreated="2005-06-23T16:30:32Z" dateModified="2026-09-28T21:04:51Z" id="na1_a9e28647-c541-4278-a2b1-6f924c2c5aa7" guid="a9e28647-c541-4278-a2b1-6f924c2c5aa7" order="1">
    <lexical-unit>
      <form lang="seh">
        <text>na</text>
      </form>
    </lexical-unit>
    <trait name="morph-type" value="root"/>
    <sense id="84e5150e-3043-4652-9f64-849cf192fee4" order="0">
      <grammatical-info value="Preposição"/>
      <gloss lang="en">
        <text>with</text>
      </gloss>
      <gloss lang="pt">
        <text>com</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>and</text>
        </form>
        <form lang="pt">
          <text>e</text>
        </form>
      </definition>
      <note>
        <form lang="en">
          <text>Question: need example for all these uses; vocrev; fuses with pronouns</text>
        </form>
      </note>
      <note type="phonology">
        <form lang="en">
          <text>alt: <span lang="seh">na / # _ | e.g. na naye nawo</span></text>
        </form>
      </note>
      <field type="Parsing Note">
        <form lang="en">
          <text>needs phone fusion rules</text>
        </form>
      </field>
      <example source="sulo2 007">
        <form lang="seh">
          <text>cifupi na phiri</text>
        </form>
        <translation type="Free translation">
          <form lang="en">
            <text>close to the mountain</text>
          </form>
          <form lang="pt">
            <text>perto de montanha</text>
          </form>
        </translation>
        <note type="reference">
          <form lang="en">
            <text>sulo2 007</text>
          </form>
        </note>
      </example>
      <example>
        <form lang="seh">
          <text>Nyakatendewa na kubva cipwazo.</text>
        </form>
        <translation type="Free translation">
          <form lang="en">
            <text>The cameleon, at hearing the insult...</text>
          </form>
          <form lang="pt">
            <text>Camaleão ao ouvir desprezo...</text>
          </form>
        </translation>
      </example>
      <trait name="semantic-domain-ddp4" value="7.4 Have, be with"/>
    </sense>
    <sense id="68e58260-9383-41f8-bb1a-7aa551e89fac" order="1">
      <grammatical-info value="Conjunção"/>
      <gloss lang="en">
        <text>and</text>
      </gloss>
      <gloss lang="pt">
        <text>e</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>"and" as a connector between verb pharses or clauses and cancels out sequentiality between events</text>
        </form>
        <form lang="pt">
          <text>e</text>
        </form>
      </definition>
    </sense>
    <sense id="91120e17-4e49-43c0-b416-00176448fdd2" order="2">
      <grammatical-info value="Preposição"/>
      <gloss lang="en">
        <text>of</text>
      </gloss>
      <gloss lang="pt">
        <text>de</text>
      </gloss>
    </sense>
    <sense id="fee1a6ff-3d64-44fa-9515-b51e7068b1d6" order="3">
      <grammatical-info value="Preposição"/>
      <gloss lang="en">
        <text>in</text>
      </gloss>
      <gloss lang="pt">
        <text>em</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>in</text>
        </form>
        <form lang="pt">
          <text>em</text>
        </form>
      </definition>
    </sense>
    <sense id="d1e7a1fe-5475-4eae-99eb-d56f7248f6c4" order="4">
      <grammatical-info value="Preposição"/>
      <gloss lang="en">
        <text>by</text>
      </gloss>
      <gloss lang="pt">
        <text>por</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>"by" only with passive verbs</text>
        </form>
        <form lang="pt">
          <text>por</text>
        </form>
      </definition>
    </sense>
    <sense id="cbad219c-e1bc-479c-877c-c0017a425ac1" order="5">
      <grammatical-info value="Preposição"/>
      <gloss lang="en">
        <text>to</text>
      </gloss>
      <gloss lang="pt">
        <text>a</text>
      </gloss>
      <definition>
        <form lang="en">
          <text>to</text>
        </form>
        <form lang="pt">
          <text>a</text>
        </form>
      </definition>
    </sense>
