<entry dateCreated="2005-06-23T16:30:31Z" dateModified="2026-08-11T13:10:00Z" id="khoboka_d5cb3ce5-cbf9-4c51-8d1f-5964ce10a703" guid="d5cb3ce5-cbf9-4c51-8d1f-5964ce10a703">
<lexical-unit>
<form lang="seh"><text>khobok</text></form>
</lexical-unit>
<trait  name="morph-type" value="root"/>
<citation>
<form lang="seh"><text>khoboka</text></form>
</citation>
<sense id="9c29d3f5-8dd8-4dd7-90a3-a71ad81c0cc1">
<grammatical-info value="Verbo">
</grammatical-info>
<gloss lang="en"><text>break</text></gloss>
<gloss lang="pt"><text>quebrar</text></gloss>
<definition>
<form lang="en"><text>break by hand</text></form>
<form lang="pt"><text>quebrar a mão</text></form>
</definition>
<example>
</example>
<example>
<form lang="seh"><text><span lang="en">wa kukhoboka ntima</span></text></form>
<translation type="Literal translation">
<form lang="en"><text>tolerant</text></form>
<form lang="pt"><text><span lang="en">tolerante</span></text></form>
</translation>
<translation type="Literal translation">
<form lang="en"><text>broken hearted</text></form>
<form lang="pt"><text>coração quebrado</text></form>
</translation>
</example>
<note>
<form lang="en"><text> (lit. broken hearted) = tolerante</text></form>
</note>
</sense>
</entry>

