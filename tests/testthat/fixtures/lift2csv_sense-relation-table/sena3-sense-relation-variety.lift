<entry dateCreated="2005-06-23T16:30:32Z" dateModified="2026-09-28T21:05:16Z" id="tsanzaya_2614a9d9-5279-4b6e-9f33-1db67d2d0100" guid="2614a9d9-5279-4b6e-9f33-1db67d2d0100">
<lexical-unit>
<form lang="seh"><text>tsanzay</text></form>
</lexical-unit>
<trait  name="morph-type" value="root"/>
<citation>
<form lang="seh"><text>tsanzaya</text></form>
</citation>
<sense id="ce9787bb-6789-49f9-9981-27b1724cef66" order="0">
<grammatical-info value="Verbo">
</grammatical-info>
<gloss lang="en"><text>happy</text></gloss>
<gloss lang="pt"><text>feliz</text></gloss>
<example source="komerwa = gostar, amar">
<form lang="seh"><text>Mwana wa kusanzaya</text></form>
<translation type="Free translation">
<form lang="pt"><text>Crianca feliz</text></form>
</translation>
<note type="reference">
<form lang="en"><text>komerwa = gostar, amar</text></form>
</note>
</example>
<example>
<form lang="seh"><text>Mwana aenda kunyumba na kusanzaya.</text></form>
<translation type="Free translation">
<form lang="pt"><text>A crianca feliz foi a casa.</text></form>
</translation>
</example>
<note>
<form lang="en"><text>See: tsanzaisa = cause to be happy; See: tsanzayisa = causar alguem ser content, alegrar alguem; we know that it is a y in the root not i because of the penultimate accent, and it must be maintained when an extension is added; Second example is as a noun (infinitive).</text></form>
</note>
<note type="phonology">
<form lang="en"><text>sanzaya</text></form>
</note>
<note type="sociolinguistics">
<form lang="en"><text>A</text></form>
</note>
<relation type="Antonym" ref="b3d7c131-2e6c-4715-a476-9cd2f74be96e"/>
<relation type="Synonyms" ref="e233ed05-a5c5-4db6-a8a7-549a611a0ae5"/>
</sense>
<sense id="d8c5c5b8-9b61-4fea-95b3-7ec530fd4644" order="1">
<grammatical-info value="Verbo">
</grammatical-info>
<gloss lang="en"><text>satisfaction</text></gloss>
<gloss lang="pt"><text>satisfação</text></gloss>
</sense>
</entry>

