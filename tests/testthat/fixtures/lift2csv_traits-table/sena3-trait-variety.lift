<entry dateCreated="2005-06-23T16:08:17Z" dateModified="2026-09-28T14:56:57Z" id="pi-1_0c7b40af-941f-402f-8b66-4721c0044c2b" guid="0c7b40af-941f-402f-8b66-4721c0044c2b" order="1">
<lexical-unit>
<form lang="seh"><text>pi-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<variant>
<form lang="seh"><text>py-</text></form>
<trait name ="environment" value="/ _ [V]"/>
<trait  name="morph-type" value="prefix"/>
</variant>
<sense id="43a4b50c-b681-4e03-ad5c-1649e7daf633" order="0">
<grammatical-info value="Nome">
<trait name="type" value="inflAffix"/>
<trait name="Nome-slot" value="ncl"/><trait name="inflection-feature" value="{Infl}[NounAgr:[genro:7/8]]"/>
</grammatical-info>
<gloss lang="en"><text>8</text></gloss>
<gloss lang="pt"><text>8</text></gloss>
<note>
<form lang="en"><text>Question: When pi serves as a second noun class marker will there be an order conflict? ie pi is -10 and so will the first marker be.</text></form>
</note>
<note type="phonology">
<form lang="en"><text>alt: <span lang="seh">py / _ [V] | eg. pyakudya pyala; pi | eg. pinthu</span></text></form>
</note>
<note type="source">
<form lang="en"><text>Schadeberg 2.1.1.2</text></form>
</note>
</sense>
