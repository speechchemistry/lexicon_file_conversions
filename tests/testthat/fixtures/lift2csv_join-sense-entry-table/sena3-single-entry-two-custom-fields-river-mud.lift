<form lang="seh"><text>matope</text></form>
</citation>
<field type="Plural">
<form lang="en"><text>thope</text></form>
</field>
<field type="Singular">
<form lang="en"><text>no singular</text></form>
</field>
<sense id="ec8fb8f1-c0bd-4c7b-a67c-2e48a1bb044b">
<grammatical-info value="Nome">
