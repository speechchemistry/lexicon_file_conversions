</note>
</example>
<trait name ="semantic-domain-ddp4" value="1.2.2.1 Soil, dirt"/>
<note>
<form lang="en"><text>this is a little mud, thope [ikulu] is deep mud; Question: So that looks like singular with a special meaning</text></form>
